PORT=4000
SPRING_BOOT_URL=http://localhost:8080

# mediasoup가 클라이언트에게 알릴 IP
# 로컬 개발: 127.0.0.1
# 서버 배포: 실제 공인 IP 입력
# 비워두면 현재 PC의 LAN IPv4를 자동 감지합니다.
# localhost만 쓸 때는 127.0.0.1, 같은 네트워크 접속은 PC의 LAN IP를 입력하세요.
ANNOUNCED_IP=
LOCAL_IP=

# 추가 허용 프론트 Origin이 있으면 쉼표로 구분합니다.
# 예: http://172.19.22.191:5173,https://demo.example.com
FRONTEND_ORIGINS=

# mediasoup UDP/TCP 포트 범위
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100
